{
    "name": "laravel/product-currency-api",
    "type": "project",
    "description": "API RESTful para la gestión de productos y precios en diferentes divisas.",
    "keywords": ["laravel", "api", "rest", "products", "currencies", "fx"],
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0 || ^11.0",
        "laravel/sanctum": "^3.2 || ^4.0",
        "laravel/tinker": "^2.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0 || ^8.1",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
