      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "currency_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Currencies",
      "item": [
        {
          "name": "List Currencies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/currencies",
              "host": ["{{base_url}}"],
              "path": ["currencies"]
            }
          }
        },
        {
          "name": "Create Currency",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CAD\",\n  \"symbol\": \"$\",\n  \"exchange_rate\": 1.36\n}"
            },
            "url": {
              "raw": "{{base_url}}/currencies",
              "host": ["{{base_url}}"],
              "path": ["currencies"]
            }
          }
        },
        {
          "name": "Get Currency by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/currencies/{{currency_id}}",
              "host": ["{{base_url}}"],
              "path": ["currencies", "{{currency_id}}"]
            }
          }
        },
        {
          "name": "Update Currency",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchange_rate\": 1.385\n}"
            },
            "url": {
              "raw": "{{base_url}}/currencies/{{currency_id}}",
              "host": ["{{base_url}}"],
              "path": ["currencies", "{{currency_id}}"]
            }
          }
        }
      ]
    },
    {
